import streamlit as st
import datetime

# 1. Cấu hình trang (Hiển thị tiêu đề trên tab trình duyệt)
st.set_page_config(
    page_title="Dự Báo Giá Cổ Phiếu bằng LSTM",
    page_icon="📈",
    layout="wide"
)

# 2. Cấu hình thanh bên (Sidebar)
st.sidebar.header("⚙️ Cấu Hình Dự Báo")

# Ô nhập mã chứng khoán
ma_ck = st.sidebar.text_input("Mã chứng khoán", value="VNM.VN")

# Ô chọn ngày bắt đầu và kết thúc
ngay_bat_dau = st.sidebar.date_input(
    "Ngày bắt đầu lấy dữ liệu", 
    datetime.date(2018, 1, 1)
)
ngay_ket_thuc = st.sidebar.date_input(
    "Ngày kết thúc", 
    datetime.date(2026, 10, 14)
)

# Thanh trượt chọn số ngày và số epoch
so_ngay_du_bao = st.sidebar.slider(
    "Số ngày muốn dự báo tương lai", 
    min_value=1, max_value=10, value=10
)
so_epochs = st.sidebar.slider(
    "Số Epochs huấn luyện", 
    min_value=5, max_value=30, value=10
)

# Nút bắt đầu
nut_bat_dau = st.sidebar.button("🚀 Bắt Đầu Dự Báo")

# 3. Cấu hình nội dung chính (Main Content)
st.title("📈 Ứng Dụng Dự Báo Giá Cổ Phiếu bằng Mô Hình LSTM")
st.markdown("Dự báo xu hướng giá cổ phiếu trong ngắn hạn và tính toán phần trăm *Lãi / Lỗ* kỳ vọng.")

# Xử lý logic khi bấm nút hoặc chưa bấm nút
if not nut_bat_dau:
    st.info("👈 Vui lòng bấm nút **'🚀 Bắt Đầu Dự Báo'** ở thanh bên trái để khởi chạy mô hình!")
else:
    st.success(f"Đang tiến hành lấy dữ liệu cho mã **{ma_ck}** từ {ngay_bat_dau} đến {ngay_ket_thuc}...")
    st.warning("Hệ thống đang huấn luyện mô hình LSTM. Quá trình này có thể mất một chút thời gian...")
    
    # Tại đây bạn sẽ chèn code thực tế về:
    # - Thư viện yfinance để tải dữ liệu chứng khoán
    # - Tiền xử lý dữ liệu (MinMaxScaler)
    # - Xây dựng và huấn luyện mô hình LSTM (TensorFlow/Keras)
    # - Vẽ biểu đồ kết quả (Plotly/Matplotlib)
