import streamlit as st
import pandas as pd
import numpy as np
# Import các thư viện cần thiết cho LSTM và xử lý dữ liệu (ví dụ: yfinance, sklearn, tensorflow/keras)
# import yfinance as yf
# from sklearn.preprocessing import MinMaxScaler
# from tensorflow.keras.models import Sequential
# from tensorflow.keras.layers import Dense, LSTM

# --- CẤU HÌNH TRANG ---
st.set_page_config(
    page_title="Dự Báo Giá Cổ Phiếu",
    page_icon="📈",
    layout="wide",
    initial_sidebar_state="expanded"
)

# --- THANH BÊN (SIDEBAR) CẤU HÌNH ---
with st.sidebar:
    st.header("⚙️ Cấu Hình Dự Báo")
    
    ticker = st.text_input("Mã chứng khoán", value="VNM.VN", help="Nhập mã chứng khoán (ví dụ: VCB.VN, FPT.VN, AAPL)")
    
    start_date = st.date_input("Ngày bắt đầu lấy dữ liệu", value=pd.to_datetime("2018-01-01"))
    end_date = st.date_input("Ngày kết thúc", value=pd.to_datetime("today"))
    
    future_days = st.slider("Số ngày muốn dự báo tương lai", min_value=1, max_value=30, value=10)
    
    epochs = st.slider("Số Epochs huấn luyện", min_value=1, max_value=100, value=10)
    
    start_button = st.button("🚀 Bắt Đầu Dự Báo", type="primary", use_container_width=True)

# --- NỘI DUNG CHÍNH ---
st.title("📈 Ứng Dụng Dự Báo Giá Cổ Phiếu bằng Mô Hình LSTM")
st.write("Dự báo xu hướng giá cổ phiếu trong ngắn hạn và tính toán phần trăm Lãi / Lỗ kỳ vọng.")

if not start_button:
    st.info("👈 Vui lòng bấm nút '🚀 Bắt Đầu Dự Báo' ở thanh bên trái để khởi chạy mô hình!")
else:
    st.write(f"Đang tiến hành dự báo cho mã: **{ticker}**")
    st.write(f"Dữ liệu từ **{start_date}** đến **{end_date}**")
    st.write(f"Dự báo **{future_days}** ngày tới, huấn luyện với **{epochs}** epochs.")
    
    # --- LOGIC XỬ LÝ VÀ DỰ BÁO SẼ ĐẶT Ở ĐÂY ---
    with st.spinner('Đang tải dữ liệu và huấn luyện mô hình...'):
        # 1. Tải dữ liệu (ví dụ dùng yfinance)
        # data = yf.download(ticker, start=start_date, end=end_date)
        
        # 2. Tiền xử lý dữ liệu (MinMaxScaler, tạo dataset cho LSTM)
        
        # 3. Xây dựng và huấn luyện mô hình LSTM
        
        # 4. Thực hiện dự báo tương lai
        
        import time
        time.sleep(2) # Giả lập thời gian chạy
        
    st.success("Dự báo hoàn tất! (Đây là dữ liệu mô phỏng)")
    
    # --- HIỂN THỊ KẾT QUẢ ---
    st.subheader("Kết quả dự báo")
    
    # Tạo dữ liệu giả để vẽ biểu đồ
    dates = pd.date_range(start=end_date, periods=future_days + 1)[1:]
    simulated_prices = np.random.normal(loc=100, scale=2, size=future_days)
    
    df_pred = pd.DataFrame({'Ngày': dates, 'Giá Dự Báo': simulated_prices})
    st.line_chart(df_pred.set_index('Ngày'))
    
    st.write(df_pred)

